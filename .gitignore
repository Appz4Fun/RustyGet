# Fetched by site/tools/fetch-vale-style.sh
site/vale/styles/Google/

# local secrets (API keys) — never commit
.env
.env.*

# local, credential-driven manual tests — never commit
tests/manual/

# Rust build output
rust/target/
tools/nzbget-observe/target/
observe-evidence/
