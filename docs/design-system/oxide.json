{
  "name": "Oxide",
  "version": 1,
  "source": "site/assets/site.css (the GitHub Pages site, https://appz4fun.github.io/RustyGet/)",
  "themes": ["light", "dark"],
  "palette": {
    "paper":        { "light": "#f7f4ef", "dark": "#12100e", "role": "Page background" },
    "surface":      { "light": "#ffffff", "dark": "#1b1714", "role": "Raised cards, tables, panels, sheets" },
    "sunken":       { "light": "#f0eae2", "dark": "#1e1915", "role": "Inset areas: code, table headers, hovered nav items" },
    "ink":          { "light": "#1c1916", "dark": "#f1eae2", "role": "Body text and icons" },
    "muted":        { "light": "#5c534b", "dark": "#b3a79b", "role": "Secondary text: help, sizes, ETAs, column headers, captions" },
    "faint":        { "light": "#9b9085", "dark": "#6f655c", "role": "Disabled text and decorative glyphs only. Below 4.5:1 on purpose" },
    "line":         { "light": "#e4dcd2", "dark": "#352e28", "role": "Hairlines: borders, rules, row dividers" },
    "line-strong":  { "light": "#cfc4b8", "dark": "#4a4038", "role": "Emphasised rules, kbd edges, hovered card borders" },
    "control-edge": { "light": "#8c8076", "dark": "#7d7166", "role": "Edges of controls that must be seen (checkbox, outlined field). 3:1 on surfaces" },
    "rust":         { "light": "#a8400f", "dark": "#f08c5a", "role": "Action and emphasis: links, primary button, current page, focus ring, primary copy of a fleet" },
    "rust-soft":    { "light": "#f7e6dc", "dark": "#3b2318", "role": "Selected row, hovered search result, new and primary tags" },
    "patina":       { "light": "#1d6f60", "dark": "#6cc9b4", "role": "Healthy and verified: success, twins proven by checksums, completed steps, help callouts" },
    "patina-soft":  { "light": "#dcefe9", "dark": "#16302a", "role": "Ground of success labels and alerts" },
    "steel":        { "light": "#3d5a73", "dark": "#9ab8d1", "role": "Reference and neutral: note callouts, alts, changed tags, info and live-repair labels" },
    "steel-soft":   { "light": "#e1e9f0", "dark": "#1d2a35", "role": "Ground of info labels and alerts" },
    "amber":        { "light": "#8a5a00", "dark": "#e3b45a", "role": "Needs attention: warnings, paused, degraded health, settings that send traffic" },
    "amber-soft":   { "light": "#f6ebd2", "dark": "#352914", "role": "Ground of warning labels and alerts" },
    "ember":        { "light": "#b02a1f", "dark": "#f2867a", "role": "Failure and danger: failed downloads, errors, destructive actions, settings that delete data" },
    "ember-soft":   { "light": "#f8e1de", "dark": "#3a1c18", "role": "Ground of error labels, alerts and the destructive button" },
    "on-accent":    { "light": "#ffffff", "dark": "#12100e", "role": "Text and glyphs on a solid rust fill" }
  },
  "contrast": [
    { "fg": "ink",       "on": ["paper", "surface", "sunken", "rust-soft", "patina-soft", "steel-soft", "amber-soft", "ember-soft"], "min": 4.5 },
    { "fg": "muted",     "on": ["paper", "surface", "sunken"], "min": 4.5 },
    { "fg": "rust",      "on": ["paper", "surface", "sunken", "rust-soft"], "min": 4.5 },
    { "fg": "patina",    "on": ["paper", "surface", "patina-soft"], "min": 4.5 },
    { "fg": "steel",     "on": ["paper", "surface", "steel-soft"], "min": 4.5 },
    { "fg": "amber",     "on": ["paper", "surface", "amber-soft"], "min": 4.5 },
    { "fg": "ember",     "on": ["paper", "surface", "ember-soft"], "min": 4.5 },
    { "fg": "on-accent", "on": ["rust"], "min": 4.5 },
    { "fg": "control-edge", "on": ["paper", "surface"], "min": 3.0 },
    { "fg": "rust",      "on": ["paper", "surface"], "min": 3.0, "note": "focus ring" }
  ],
  "shadow": {
    "shadow":  { "light": "0 1px 2px #1c19160d, 0 8px 24px #1c19160a", "dark": "0 1px 2px #0006, 0 8px 24px #0004", "role": "Hovered cards and floating panels only" }
  },
  "type": {
    "families": {
      "sans": "system-ui, -apple-system, \"Segoe UI\", Roboto, \"Helvetica Neue\", Arial, sans-serif",
      "mono": "ui-monospace, \"JetBrains Mono\", \"Cascadia Code\", \"SF Mono\", Menlo, Consolas, monospace"
    },
    "scale": [
      { "name": "page-title", "size": "clamp(2rem, 3.4vw, 2.75rem)", "lineHeight": 1.2, "weight": 680, "tracking": "-0.035em", "family": "sans" },
      { "name": "h2",         "size": "1.55rem", "lineHeight": 1.2, "weight": 680, "tracking": "-0.02em", "family": "sans" },
      { "name": "h3",         "size": "1.15rem", "lineHeight": 1.2, "weight": 680, "tracking": "-0.02em", "family": "sans" },
      { "name": "lede",       "size": "1.15rem", "lineHeight": 1.6, "weight": 400, "family": "sans", "color": "muted" },
      { "name": "body",       "size": "16px",    "lineHeight": 1.65, "weight": 400, "family": "sans" },
      { "name": "small",      "size": "0.9rem",  "lineHeight": 1.55, "weight": 400, "family": "sans" },
      { "name": "code",       "size": "0.86rem", "lineHeight": 1.6, "weight": 400, "family": "mono" },
      { "name": "label",      "size": "0.7rem",  "lineHeight": 1.4, "weight": 600, "tracking": "0.08em", "transform": "uppercase", "family": "mono", "color": "muted" },
      { "name": "eyebrow",    "size": "0.74rem", "lineHeight": 1.4, "weight": 600, "tracking": "0.06em", "transform": "uppercase", "family": "mono", "color": "rust" },
      { "name": "tag",        "size": "0.68rem", "lineHeight": 1.5, "weight": 600, "tracking": "0.03em", "family": "mono" }
    ],
    "measure": "76ch"
  },
  "radius": { "radius-xs": "4px", "radius-sm": "6px", "radius": "10px", "radius-full": "999px" },
  "space":  { "space-1": "4px", "space-2": "8px", "space-3": "12px", "space-4": "16px", "space-5": "20px", "space-6": "24px", "space-8": "32px", "space-10": "40px" },
  "layout": { "masthead": "60px", "gutter": "40px", "gutter-phone": "16px", "content": "800px", "content-wide": "1120px", "page-max": "1560px" },
  "webui": {
    "_doc": "Maps the web UI's existing token names (docs/design-system/tokens.json) onto Oxide. A string is a palette reference or a literal used in both themes; an object gives per-theme values.",
    "bg-window": "paper",
    "bg-content": "surface",
    "bg-elevated": "surface",
    "bg-glass": { "light": "rgba(255, 255, 255, 0.80)", "dark": "rgba(27, 23, 20, 0.80)" },
    "fill-primary": { "light": "rgba(28, 25, 22, 0.12)", "dark": "rgba(241, 234, 226, 0.14)" },
    "fill-secondary": { "light": "rgba(28, 25, 22, 0.08)", "dark": "rgba(241, 234, 226, 0.10)" },
    "fill-tertiary": { "light": "rgba(28, 25, 22, 0.05)", "dark": "rgba(241, 234, 226, 0.06)" },
    "fill-quaternary": { "light": "rgba(28, 25, 22, 0.03)", "dark": "rgba(241, 234, 226, 0.03)" },
    "label-primary": "ink",
    "label-secondary": "muted",
    "label-tertiary": "faint",
    "separator": "line",
    "rule": "line-strong",
    "control-border": "control-edge",
    "grid-line": { "light": "rgba(28, 25, 22, 0.045)", "dark": "rgba(241, 234, 226, 0.03)" },
    "accent": "rust",
    "accent-fill": "rust",
    "on-accent": "on-accent",
    "accent-soft": "rust-soft",
    "focus-ring": "rust",
    "brand": "rust",
    "green": "patina",
    "green-text": "patina",
    "green-soft": "patina-soft",
    "yellow": "amber",
    "yellow-text": "amber",
    "yellow-soft": "amber-soft",
    "red": "ember",
    "red-text": "ember",
    "red-soft": "ember-soft",
    "cyan": "steel",
    "cyan-text": "steel",
    "cyan-soft": "steel-soft",
    "scrim": { "light": "rgba(28, 25, 22, 0.30)", "dark": "rgba(0, 0, 0, 0.60)" },
    "shadow-control": { "light": "0 1px 2px #1c19160d, inset 0 0 0 1px #e4dcd2", "dark": "0 1px 2px #0006, inset 0 0 0 1px #352e28" },
    "shadow-glass": { "light": "0 1px 2px #1c19160d, 0 8px 24px #1c19160a, 0 0 0 1px #e4dcd2", "dark": "0 1px 2px #0006, 0 8px 24px #0004, 0 0 0 1px #352e28" },
    "shadow-card": { "light": "0 0 0 1px #e4dcd2", "dark": "0 0 0 1px #352e28" },
    "shadow-popover": { "light": "0 1px 2px #1c19160d, 0 8px 24px #1c19161a, 0 0 0 1px #e4dcd2", "dark": "0 1px 2px #0006, 0 12px 32px #0008, 0 0 0 1px #4a4038" },
    "shadow-sheet": { "light": "0 2px 4px #1c191610, 0 24px 64px #1c191626, 0 0 0 1px #e4dcd2", "dark": "0 2px 4px #0008, 0 24px 64px #000a, 0 0 0 1px #4a4038" },
    "shadow-glow": "none",
    "radius-sm": "4px",
    "radius-md": "6px",
    "radius-lg": "10px",
    "radius-xl": "10px",
    "font-sans": "{type.sans}",
    "font-mono": "{type.mono}"
  }
}
